{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.4.2",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium",
        "autoIncrement": "buildNumber"
      },
      "environment": "preview",
      "env": {
        "HOT_UPDATER_CHANNEL": "preview"
      }
    },
    "production": {
      "bun": "1.4.2",
      "env": {
        "HOT_UPDATER_CHANNEL": "production"
      },
      "ios": {
        "resourceClass": "m-medium",
        "autoIncrement": "buildNumber"
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": "versionCode"
      },
      "environment": "production"
    },
    "play-preview": {
      "extends": "production",
      "distribution": "store",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_HOT_UPDATER_ENABLED": "1",
        "HOT_UPDATER_CHANNEL": "preview",
        "HOT_UPDATER_NATIVE_BUILD": "1"
      },
      "android": {
        "credentialsSource": "remote",
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "play-preview": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    },
    "testflight": {
      "ios": {
        "ascAppId": "6793419283",
        "appleTeamId": "452NUF9UZZ"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6793419283",
        "appleTeamId": "452NUF9UZZ"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
