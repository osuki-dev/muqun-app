expo-image 58.0.16: cap the on-disk image caches at 100 MB.

Android: ExpoImageAppGlideModule builds Glide's InternalCacheDiskCacheFactory
without a size, so the cache grows to Glide's 250 MB default and stays there.
iOS: SDImageCache.shared has no maxDiskSize by default (unlimited until the
one-week age sweep). Both now evict least recently used entries above 100 MB;
evicted thumbnails are fetched again on the next view.

Glide allows a single AppGlideModule and expo-image ships it, so the size
cannot be set from the app. Remove this patch when expo-image exposes a disk
cache size option.
diff --git a/android/src/main/java/expo/modules/image/ExpoImageAppGlideModule.kt b/android/src/main/java/expo/modules/image/ExpoImageAppGlideModule.kt
index 39de154..39f2458 100644
--- a/android/src/main/java/expo/modules/image/ExpoImageAppGlideModule.kt
+++ b/android/src/main/java/expo/modules/image/ExpoImageAppGlideModule.kt
@@ -24,7 +24,7 @@ class ExpoImageAppGlideModule : AppGlideModule() {
     super.applyOptions(context, builder)
 
     builder.setDiskCache(
-      ExpoImageDiskCache.Factory(InternalCacheDiskCacheFactory(context))
+      ExpoImageDiskCache.Factory(InternalCacheDiskCacheFactory(context, 100L * 1024 * 1024))
     )
 
     builder.setLogLevel(
diff --git a/ios/ImageModule.swift b/ios/ImageModule.swift
index c480af3..2de0226 100644
--- a/ios/ImageModule.swift
+++ b/ios/ImageModule.swift
@@ -21,6 +21,7 @@ public final class ImageModule: Module {
     OnStopObserving("imageLoaded") { self.hasImageLoadedListener = false }
 
     OnCreate {
+      SDImageCache.shared.config.maxDiskSize = 100 * 1024 * 1024
       ImageModule.registerCoders()
       ImageModule.registerLoaders()
     }
