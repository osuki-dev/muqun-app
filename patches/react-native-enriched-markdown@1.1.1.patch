diff --git a/android/src/test/java/com/swmansion/enriched/markdown/EnrichedMarkdownLifecycleTest.kt b/android/src/test/java/com/swmansion/enriched/markdown/EnrichedMarkdownLifecycleTest.kt
new file mode 100644
--- /dev/null
+++ b/android/src/test/java/com/swmansion/enriched/markdown/EnrichedMarkdownLifecycleTest.kt
@@ -0,0 +1,108 @@
+package com.swmansion.enriched.markdown
+
+import android.os.Looper
+import com.facebook.react.bridge.JavaOnlyMap
+import com.facebook.react.uimanager.StateWrapper
+import java.lang.reflect.Proxy
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+import org.junit.runner.RunWith
+import org.robolectric.RobolectricTestRunner
+import org.robolectric.RuntimeEnvironment
+import org.robolectric.Shadows.shadowOf
+import org.robolectric.annotation.Config
+import org.robolectric.annotation.LooperMode
+
+@RunWith(RobolectricTestRunner::class)
+@Config(manifest = Config.NONE, sdk = [28])
+@LooperMode(LooperMode.Mode.PAUSED)
+class EnrichedMarkdownLifecycleTest {
+  // Exercise the actual native view and its actual Handler, without invoking the
+  // ARM-only markdown parser. Reflection only opens the render-completion seam.
+  private fun postResult(view: EnrichedMarkdown, renderId: Long = 0L, action: () -> Unit) {
+    val method = EnrichedMarkdown::class.java.getDeclaredMethod(
+      "postToMain", Long::class.javaPrimitiveType, Function0::class.java,
+    )
+    method.isAccessible = true
+    method.invoke(view, renderId, action)
+  }
+
+  @Test
+  fun liveResultRunsBeforeFirstAttachmentButDroppedQueuedResultDoesNot() {
+    val view = EnrichedMarkdown(RuntimeEnvironment.getApplication())
+    var applied = 0
+    assertFalse(view.isAttachedToWindow)
+    postResult(view) { applied++ }
+    shadowOf(Looper.getMainLooper()).idle()
+    assertEquals(1, applied)
+
+    postResult(view) { applied++ }
+    view.cleanup()
+    shadowOf(Looper.getMainLooper()).idle()
+    assertEquals(1, applied)
+  }
+
+  @Test
+  fun workerPostingAfterCleanupCannotApplyItsResult() {
+    val view = EnrichedMarkdown(RuntimeEnvironment.getApplication())
+    val releaseWorker = CountDownLatch(1)
+    val posted = CountDownLatch(1)
+    var applied = false
+    val worker = Thread {
+      check(releaseWorker.await(5, TimeUnit.SECONDS))
+      postResult(view) { applied = true }
+      posted.countDown()
+    }
+    worker.start()
+    view.cleanup()
+    // Deliberately post after cleanup's queue removal, as non-interruptible work can.
+    releaseWorker.countDown()
+    assertTrue(posted.await(5, TimeUnit.SECONDS))
+    worker.join()
+    shadowOf(Looper.getMainLooper()).idle()
+    assertFalse(applied)
+  }
+
+  @Test
+  fun cleanupReleasesStateAndIgnoresLateImageLayout() {
+    val view = EnrichedMarkdown(RuntimeEnvironment.getApplication())
+    view.layout(0, 0, 100, 100)
+    view.onImageLayoutChanged()
+    assertTrue(view.isLayoutRequested)
+    view.layout(0, 0, 100, 100)
+    assertFalse(view.isLayoutRequested)
+    view.stateWrapper = Proxy.newProxyInstance(
+      StateWrapper::class.java.classLoader,
+      arrayOf(StateWrapper::class.java),
+    ) { _, method, _ ->
+      if (method.name == "toString") "TestStateWrapper" else error("Unexpected Fabric state call")
+    } as StateWrapper
+    view.cleanup()
+    assertNull(view.stateWrapper)
+    view.onImageLayoutChanged()
+    assertFalse(view.isLayoutRequested)
+  }
+
+  @Test
+  fun cleanupRejectsNoFurtherRenderSubmissionsOrPropBookkeeping() {
+    val view = EnrichedMarkdown(RuntimeEnvironment.getApplication())
+    view.id = 91327
+    // StyleConfig lazily parses its contents. No native parser should run after drop.
+    view.setMarkdownStyle(JavaOnlyMap())
+    view.setMarkdownContent("Late update")
+    view.cleanup()
+    view.cleanup() // Teardown is idempotent.
+    view.commitProps()
+    val settings = MeasurementStore::class.java.getDeclaredField("fontScalingSettings")
+    settings.isAccessible = true
+    assertFalse((settings.get(MeasurementStore) as Map<*, *>).containsKey(view.id))
+    val schedule = EnrichedMarkdown::class.java.getDeclaredMethod("scheduleRender")
+    schedule.isAccessible = true
+    schedule.invoke(view) // Previously throws RejectedExecutionException synchronously.
+  }
+}
