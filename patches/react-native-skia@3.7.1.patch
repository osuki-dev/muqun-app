diff --git a/src/sksg/presentation.test.ts b/src/sksg/presentation.test.ts
new file mode 100644
index 00000000..bc24a505
--- /dev/null
+++ b/src/sksg/presentation.test.ts
@@ -0,0 +1,124 @@
+import { beforeEach, expect, mock, test } from "bun:test";
+
+const commits: (() => void)[] = [];
+const presentations: ((shown: boolean) => void)[] = [];
+let redraws = 0;
+const container = {
+  mount() {},
+  unmount() {},
+  redraw() {
+    redraws++;
+  },
+};
+mock.module("./Container", () => ({ createContainer: () => container }));
+mock.module("./HostConfig", () => ({ debug() {}, sksgHostConfig: {} }));
+mock.module("./Elements", () => ({}));
+mock.module("react-reconciler", () => ({
+  default: () => ({
+    injectIntoDevTools() {},
+    createContainer() {
+      return container;
+    },
+    updateContainer(
+      _element: unknown,
+      _root: unknown,
+      _parent: unknown,
+      done: () => void
+    ) {
+      commits.push(() => {
+        container.redraw();
+        done();
+      });
+    },
+  }),
+}));
+const { SkiaSGRoot } = await import("./Reconciler");
+const tick = async () => {
+  for (let i = 0; i < 6; i++) await Promise.resolve();
+};
+beforeEach(() => {
+  commits.length = 0;
+  presentations.length = 0;
+  redraws = 0;
+  Object.assign(globalThis, {
+    SkiaViewApi: {
+      whenPresented: () =>
+        new Promise<boolean>((resolve) => presentations.push(resolve)),
+    },
+  });
+});
+const root = () => new SkiaSGRoot({} as never, 1);
+test("does not acknowledge the old native frame before the React commit", async () => {
+  const scene = root();
+  void scene.render(null);
+  let ready = false;
+  const pending = scene.whenPresented().then((value) => {
+    ready = value;
+  });
+  await tick();
+  expect(presentations.length).toBe(0);
+  commits.shift()!();
+  await tick();
+  expect(redraws).toBe(1);
+  expect(ready).toBe(false);
+  presentations.shift()!(true);
+  await pending;
+  expect(ready).toBe(true);
+});
+test("follows a newer commit arriving while the native frame is pending", async () => {
+  const scene = root();
+  void scene.render(null);
+  commits.shift()!();
+  const pending = scene.whenPresented();
+  await tick();
+  const oldFrame = presentations.shift()!;
+  void scene.render(null);
+  oldFrame(true);
+  await tick();
+  expect(presentations.length).toBe(0);
+  commits.shift()!();
+  await tick();
+  expect(presentations.length).toBe(1);
+  presentations.shift()!(true);
+  expect(await pending).toBe(true);
+  expect(redraws).toBe(2);
+});
+test("unmount cancels even when native has not returned; late success is ignored", async () => {
+  const scene = root();
+  void scene.render(null);
+  commits.shift()!();
+  const pending = scene.whenPresented();
+  await tick();
+  void scene.unmount();
+  expect(await pending).toBe(false);
+  presentations.shift()!(true);
+  await tick();
+  expect(presentations.length).toBe(0);
+});
+
+test("snapshot invalidated by a newer React commit is disposed, not returned", async () => {
+  const scene = root();
+  void scene.render(null);
+  commits.shift()!();
+  let finishImage: (image: { dispose(): void }) => void = () => {};
+  let disposed = false;
+  Object.assign(globalThis.SkiaViewApi, {
+    makePresentedImageSnapshot: () =>
+      new Promise((resolve) => {
+        finishImage = resolve;
+      }),
+  });
+  const snapshot = scene.makePresentedImageSnapshot();
+  await tick();
+  presentations.shift()!(true);
+  await tick();
+  void scene.render(null);
+  commits.shift()!();
+  finishImage({
+    dispose() {
+      disposed = true;
+    },
+  });
+  expect(await snapshot).toBeNull();
+  expect(disposed).toBe(true);
+});
