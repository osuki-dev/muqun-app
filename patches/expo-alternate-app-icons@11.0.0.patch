diff --git a/android/src/main/java/expo/modules/alternateappicons/IconStateMigration.kt b/android/src/main/java/expo/modules/alternateappicons/IconStateMigration.kt
new file mode 100644
index 0000000000000000000000000000000000000000..1d78f0a1af2d8e4d679c01364d1ce2a2a98a67cd
--- /dev/null
+++ b/android/src/main/java/expo/modules/alternateappicons/IconStateMigration.kt
@@ -0,0 +1,79 @@
+package expo.modules.alternateappicons
+
+import android.content.ComponentName
+import android.content.Context
+import android.content.pm.PackageManager
+import android.os.Build
+import android.util.Log
+
+internal data class IconStateMigrationPlan(
+  val enableMainActivity: Boolean,
+  val disableImplicitDefault: Boolean
+)
+
+internal fun planIconStateMigration(
+  mainState: Int,
+  defaultState: Int?,
+  hasExplicitAlternate: Boolean
+): IconStateMigrationPlan {
+  val knownMainState = mainState == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT ||
+    mainState == PackageManager.COMPONENT_ENABLED_STATE_ENABLED ||
+    mainState == PackageManager.COMPONENT_ENABLED_STATE_DISABLED
+  return IconStateMigrationPlan(
+    enableMainActivity = mainState == PackageManager.COMPONENT_ENABLED_STATE_DISABLED,
+    disableImplicitDefault = knownMainState && hasExplicitAlternate &&
+      defaultState == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT
+  )
+}
+
+internal object IconStateMigration {
+  fun migrate(context: Context) {
+    val pm = context.packageManager
+    val packageName = context.packageName
+    try {
+      val activities = pm.getPackageInfo(
+        packageName,
+        PackageManager.GET_ACTIVITIES or PackageManager.MATCH_DISABLED_COMPONENTS
+      ).activities.orEmpty()
+      val main = activities.firstOrNull {
+        it.name == "$packageName.$MAIN_ACTIVITY_NAME" && it.targetActivity == null
+      } ?: return
+      val aliases = activities.filter {
+        it.targetActivity == main.name && it.name.startsWith("$packageName.$MAIN_ACTIVITY_NAME")
+      }
+      val defaultAlias = aliases.firstOrNull { it.name == "$packageName.$DEFAULT_ALIAS_NAME" }
+      val plan = planIconStateMigration(
+        pm.getComponentEnabledSetting(ComponentName(packageName, main.name)),
+        defaultAlias?.let { pm.getComponentEnabledSetting(ComponentName(packageName, it.name)) },
+        aliases.any {
+          it !== defaultAlias &&
+            pm.getComponentEnabledSetting(ComponentName(packageName, it.name)) ==
+            PackageManager.COMPONENT_ENABLED_STATE_ENABLED
+        }
+      )
+      val changes = mutableListOf<Pair<ComponentName, Int>>()
+      // Versions before 11 disabled MainActivity when selecting an alternate.
+      // Keep that explicit alternate; only suppress the newly implicit Default.
+      if (plan.enableMainActivity) {
+        changes.add(ComponentName(packageName, main.name) to PackageManager.COMPONENT_ENABLED_STATE_ENABLED)
+      }
+      if (plan.disableImplicitDefault && defaultAlias != null) {
+        changes.add(ComponentName(packageName, defaultAlias.name) to PackageManager.COMPONENT_ENABLED_STATE_DISABLED)
+      }
+      if (changes.isEmpty()) return
+      if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.TIRAMISU) {
+        pm.setComponentEnabledSettings(changes.map { (component, state) ->
+          PackageManager.ComponentEnabledSetting(component, state, PackageManager.DONT_KILL_APP)
+        })
+      } else {
+        changes.forEach { (component, state) ->
+          pm.setComponentEnabledSetting(component, state, PackageManager.DONT_KILL_APP)
+        }
+      }
+    } catch (exception: Exception) {
+      // A package update can race package-manager reads. Retry at module init
+      // instead of making a failed repair crash an otherwise usable launcher.
+      Log.w("ExpoAlternateAppIcons", "Could not migrate legacy icon components", exception)
+    }
+  }
+}
diff --git a/android/src/main/java/expo/modules/alternateappicons/IconStateMigrationReceiver.kt b/android/src/main/java/expo/modules/alternateappicons/IconStateMigrationReceiver.kt
new file mode 100644
index 0000000000000000000000000000000000000000..8c474b6ae782ea7350b0c7a5ead2d70f8db64785
--- /dev/null
+++ b/android/src/main/java/expo/modules/alternateappicons/IconStateMigrationReceiver.kt
@@ -0,0 +1,13 @@
+package expo.modules.alternateappicons
+
+import android.content.BroadcastReceiver
+import android.content.Context
+import android.content.Intent
+
+class IconStateMigrationReceiver : BroadcastReceiver() {
+  override fun onReceive(context: Context, intent: Intent) {
+    if (intent.action == Intent.ACTION_MY_PACKAGE_REPLACED) {
+      IconStateMigration.migrate(context)
+    }
+  }
+}
diff --git a/android/src/test/java/expo/modules/alternateappicons/IconStateMigrationTest.kt b/android/src/test/java/expo/modules/alternateappicons/IconStateMigrationTest.kt
new file mode 100644
index 0000000000000000000000000000000000000000..91123673e6886d429b8fac9e63a1a7a2756c0283
--- /dev/null
+++ b/android/src/test/java/expo/modules/alternateappicons/IconStateMigrationTest.kt
@@ -0,0 +1,41 @@
+package expo.modules.alternateappicons
+
+import android.content.pm.PackageManager.COMPONENT_ENABLED_STATE_DEFAULT as DEFAULT
+import android.content.pm.PackageManager.COMPONENT_ENABLED_STATE_DISABLED as DISABLED
+import android.content.pm.PackageManager.COMPONENT_ENABLED_STATE_DISABLED_UNTIL_USED as DISABLED_UNTIL_USED
+import android.content.pm.PackageManager.COMPONENT_ENABLED_STATE_DISABLED_USER as DISABLED_USER
+import android.content.pm.PackageManager.COMPONENT_ENABLED_STATE_ENABLED as ENABLED
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class IconStateMigrationTest {
+  @Test
+  fun legacyAlternateKeepsItsSelectionAndRestoresLinks() {
+    assertEquals(IconStateMigrationPlan(true, true), planIconStateMigration(DISABLED, DEFAULT, true))
+  }
+
+  @Test
+  fun successfulRepairAndRepeatedInitializationAreNoOps() {
+    assertEquals(IconStateMigrationPlan(false, false), planIconStateMigration(ENABLED, DISABLED, true))
+    assertEquals(IconStateMigrationPlan(false, true), planIconStateMigration(ENABLED, DEFAULT, true))
+  }
+
+  @Test
+  fun freshAndExplicitDefaultSelectionsArePreserved() {
+    assertEquals(IconStateMigrationPlan(false, false), planIconStateMigration(DEFAULT, DEFAULT, false))
+    assertEquals(IconStateMigrationPlan(true, false), planIconStateMigration(DISABLED, ENABLED, false))
+    assertEquals(IconStateMigrationPlan(true, false), planIconStateMigration(DISABLED, ENABLED, true))
+  }
+
+  @Test
+  fun missingDefaultAliasDoesNotCreateOrDisableAComponent() {
+    assertEquals(IconStateMigrationPlan(true, false), planIconStateMigration(DISABLED, null, true))
+  }
+
+  @Test
+  fun userAndUnknownDisabledStatesAreNotOverridden() {
+    for (state in listOf(DISABLED_USER, DISABLED_UNTIL_USED, 99)) {
+      assertEquals(IconStateMigrationPlan(false, false), planIconStateMigration(state, DEFAULT, true))
+    }
+  }
+}
