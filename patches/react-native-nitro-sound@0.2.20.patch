react-native-nitro-sound 0.2.20 (iOS): release owned audio sessions on stop,
including recording startup failure before a recorder exists and playback stop.
Muqun serializes recording/playback and awaits startup before stopping/disposal.
Remove when upstream stopRecorder and stopPlayer deactivate their audio sessions.

diff --git a/ios/Sound.swift b/ios/Sound.swift
index c680b8d084d5f5f936fdeb4eaefaf9001e90c205..541f5547972b7eb4cce8ee67a7fb3e0880679968 100644
--- a/ios/Sound.swift
+++ b/ios/Sound.swift
@@ -40,6 +40,7 @@ final class HybridSound: HybridSoundSpec_base, HybridSoundSpec_protocol {
     private var subscriptionDuration: TimeInterval = 0.06
     private var playbackRate: Double = 1.0 // default 1x
     private var recordingSession: AVAudioSession?
+    private var playbackSession: AVAudioSession?
     // Returned by repeated stopRecorder() calls so every call yields the same
     // file URI instead of a sentinel string a caller could mistake for a path.
     private var lastRecordingURI: String?
@@ -434,6 +435,10 @@ final class HybridSound: HybridSoundSpec_base, HybridSoundSpec_protocol {
                     }
                 }
             } else {
+                // Startup can fail after activating the audio session but
+                // before an AVAudioRecorder exists (including denied access).
+                try? self.recordingSession?.setActive(false, options: .notifyOthersOnDeactivation)
+                self.recordingSession = nil
