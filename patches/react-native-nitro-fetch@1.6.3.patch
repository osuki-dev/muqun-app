diff --git a/node_modules/react-native-nitro-fetch/android/src/main/java/com/margelo/nitro/nitrofetch/MutationUploadPolicy.java b/android/src/main/java/com/margelo/nitro/nitrofetch/MutationUploadPolicy.java
new file mode 100644
index 0000000000000000000000000000000000000000..59eedfc82aaf1ede7f1b6f9cbc786a9832639093
--- /dev/null
+++ b/android/src/main/java/com/margelo/nitro/nitrofetch/MutationUploadPolicy.java
@@ -0,0 +1,59 @@
+package com.margelo.nitro.nitrofetch;
+
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.util.Locale;
+import org.chromium.net.ExperimentalUrlRequest;
+import org.chromium.net.UploadDataProvider;
+import org.chromium.net.UploadDataSink;
+import org.chromium.net.UrlRequest;
+
+/** Muqun: mutations are one transport attempt; ambiguous outcomes require receipt lookup. */
+public final class MutationUploadPolicy {
+  private MutationUploadPolicy() {}
+
+  public static boolean allowsReplay(String method) {
+    String normalized = method.toUpperCase(Locale.ROOT);
+    return normalized.equals("GET") || normalized.equals("HEAD") || normalized.equals("OPTIONS");
+  }
+
+  public static void configure(UrlRequest.Builder builder, String method) {
+    if (allowsReplay(method)) return;
+    if (!(builder instanceof ExperimentalUrlRequest.Builder)) {
+      throw new IllegalStateException("Mutation transport requires Cronet idempotency support");
+    }
+    ((ExperimentalUrlRequest.Builder) builder)
+        .setIdempotency(ExperimentalUrlRequest.Builder.NOT_IDEMPOTENT);
+  }
+
+  public static UploadDataProvider body(byte[] bytes, String method) {
+    final boolean replayAllowed = allowsReplay(method);
+    return new UploadDataProvider() {
+      private int position;
+      private boolean refused;
+
+      @Override public long getLength() { return bytes.length; }
+
+      @Override public void read(UploadDataSink sink, ByteBuffer buffer) {
+        if (refused) {
+          sink.onReadError(new IOException("Mutation upload replay refused"));
+          return;
+        }
+        int count = Math.min(buffer.remaining(), bytes.length - position);
+        buffer.put(bytes, position, count);
+        position += count;
+        sink.onReadSucceeded(false);
+      }
+
+      @Override public void rewind(UploadDataSink sink) {
+        if (!replayAllowed) {
+          refused = true;
+          sink.onRewindError(new IOException("Mutation upload replay refused; reconcile its receipt"));
+          return;
+        }
+        position = 0;
+        sink.onRewindSucceeded();
+      }
+    };
+  }
+}
