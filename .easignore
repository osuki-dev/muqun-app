# Keep this file in sync with .gitignore. EAS prioritizes .easignore when present.

# dependencies
node_modules/

# Expo
.expo/
dist/
credentials.json
eas.json.tmp
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# Files that are not used by the cloud build
.git
/.agents/
/.claude/
/.codex/
/.vscode/
/docs/
/maestro/
/marketing/
# Untracked here, so .gitignore does not keep it out of an upload: EAS reads
# this file instead the moment it exists.
/private/
.fizzyx.yaml
store.config.json
AGENTS.md
CLAUDE.md
LICENSE
README.md

# `eas metadata:pull` writes App Store Connect's own copy of the screenshots
# here -- 47MB the build has no use for.
/store/

# The README's screenshots, 1.8MB of them. README.md itself is already excluded
# above, so nothing in the upload can reference these; Metro only bundles assets
# a `require` reaches, so they were never in a binary either. This keeps them out
# of the tarball that gets uploaded on every cloud build.
/assets/readme/
