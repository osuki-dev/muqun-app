# Gateway transport encryption in development.
#
# Off by default now: a paired gateway that requires encryption (the usual
# deployment) refuses a client that was told never to encrypt, so a dev build
# with this on could not pair with one. A record paired with a cleartext
# gateway stays cleartext on its own -- encryption is per record -- so leaving
# this off costs nothing. Set to true only to debug the wire by hand.
EXPO_PUBLIC_DISABLE_GATEWAY_ENCRYPTION=false
