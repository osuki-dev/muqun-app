# Deployment machine only; copy to .env.hotupdater (ignored and excluded from EAS).
# Account API token needs D1 edit. R2 S3 credentials need only this private bucket.
HOT_UPDATER_CLOUDFLARE_ACCOUNT_ID=
HOT_UPDATER_CLOUDFLARE_API_TOKEN=
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_ID=
HOT_UPDATER_CLOUDFLARE_D1_DATABASE_NAME=
HOT_UPDATER_CLOUDFLARE_R2_BUCKET_NAME=
HOT_UPDATER_CLOUDFLARE_R2_ACCESS_KEY_ID=
HOT_UPDATER_CLOUDFLARE_R2_SECRET_ACCESS_KEY=
HOT_UPDATER_CLOUDFLARE_WORKER_NAME=
HOT_UPDATER_SIGNING_PRIVATE_KEY_PATH=
# Public client access credential, NEVER a Cloudflare/admin/signing secret.
# Provision with the generated helper, then supply to native AND OTA builds.
EXPO_PUBLIC_HOT_UPDATER_API_KEY=
EXPO_PUBLIC_HOT_UPDATER_ENABLED=0
HOT_UPDATER_CHANNEL=ota-test
