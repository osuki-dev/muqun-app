# Voice configuration is opt-in, validates HTTPS, and can be removed without recording.

# section verify
wait "id=\"settings-voice-sheet\"" 10000
fill "id=\"voice-service-url\"" "http://example.invalid/v1"
keyboard dismiss
fill "id=\"voice-service-key\"" "qa-placeholder-token"
keyboard dismiss
scroll down --until "id=\"voice-service-model\""
fill "id=\"voice-service-model\"" "qa-transcription"
keyboard dismiss
scroll down --until "id=\"voice-settings-save\""
press "id=\"voice-settings-save\""
scroll down --until "label=\"Enter an HTTPS base URL, API key and model\""
wait "label=\"Enter an HTTPS base URL, API key and model\"" 5000
scroll up --until "id=\"voice-service-url\""
fill "id=\"voice-service-url\"" "https://example.invalid/v1"
keyboard dismiss
scroll down --until "id=\"voice-settings-save\""
press "id=\"voice-settings-save\""
scroll down --until "label=\"Saved\""
wait "label=\"Saved\"" 5000
press "id=\"voice-settings-clear\""
wait "label=\"Voice to text disabled\"" 5000
screenshot "shots/voice-settings.png"

# section close
back --system
