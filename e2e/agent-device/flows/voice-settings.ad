# Voice configuration is opt-in, validates HTTPS, and can be removed without recording.

# section verify
wait "id=\"settings-voice-sheet\"" 10000
fill "id=\"voice-service-url\"" "http://example.invalid/v1"
keyboard enter
# API key and model remain empty: URL-only configuration must save.
scroll down --until "id=\"voice-settings-save\""
press "id=\"voice-settings-save\""
scroll down --until "label=\"Enter a valid HTTPS API URL. API key and model are optional\""
wait "label=\"Enter a valid HTTPS API URL. API key and model are optional\"" 5000
scroll up --until "id=\"voice-service-url\""
fill "id=\"voice-service-url\"" ""
fill "id=\"voice-service-url\"" "https://example.invalid/custom/speech/?api-version=2026-01" --delay-ms 30
keyboard enter
scroll down --until "id=\"voice-settings-save\""
press "id=\"voice-settings-save\""
wait "id=\"settings-voice-row\"" 5000
wait absent "id=\"settings-voice-sheet\"" 5000
press "id=\"settings-voice-row\""
wait "id=\"voice-service-url\" value=\"https://example.invalid/custom/speech/?api-version=2026-01\"" 5000
scroll down --until "id=\"voice-settings-clear\""
press "id=\"voice-settings-clear\""
wait "label=\"Voice to text disabled\"" 5000
screenshot "shots/voice-settings.png"

# section close
back --system
