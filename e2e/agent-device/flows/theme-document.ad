# An explicitly opened document offers preview without changing the current theme.

# section open
wait "text=\"Open files\"" 15000
press "text=\"Open files\""

# section scroll
scroll down --pixels 350

# section preview
press "${TARGET}"
wait "id=asset-preview-theme" 10000
press "id=asset-preview-theme"
wait "id=custom-theme-preview" 10000
# The restructured asset viewer puts the appearance settings between the
# preview and its confirm, so `theme-apply` starts below the fold on a phone.
scroll down --pixels 900
is visible "id=theme-apply"
screenshot "shots/theme-document.png"
# Back to the header, where the viewer's own close control is.
scroll up --pixels 900
press "id=theme-close-preview"
wait "id=asset-preview-theme" 10000
press "label=\"Close file\""
# The files sheet has no X circle any more -- the grabber and the swipe are the
# close -- so the header anchor is its refresh, and the dismissal is the
# gesture a reader has.
wait "label=\"Refresh files\"" 10000
back --system
