# Closed Mermaid fences render inside an agent transcript and open the native viewer.
# section open
open "muqun://agent-subagent-detail?asid=demo-tree-leaf-24"
wait stable 400 5000

# section visible
is visible "${TARGET}"

# section press
press "${TARGET}"

# section close
back --system

# section fullscreen-evidence
# Retain the native hierarchy and pixels for inset/handle review. The named
# close action remains exercised by the existing press-and-return assertions.
is visible "id=diagram-close"
snapshot
screenshot "shots/diagram-fullscreen-inset-close.png"

# section viewer-closed
is hidden "id=diagram-viewer-canvas"
is hidden "id=diagram-close"
