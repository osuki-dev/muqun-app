# Offline read-only linked-checkout browsing; no real pane or checkout moves.

# section open
open "muqun://git-diff?sessionId=default&paneId=pane-1&worktrees=1"
wait stable 400 8000

# section visible
is visible "${TARGET}"

# section hidden
is hidden "${TARGET}"

# section press
press "${TARGET}"
wait stable 400 8000

# section close
back --system
