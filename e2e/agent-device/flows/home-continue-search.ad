# Opt-in offline Home inventory; phones exercise both Home layouts.
# Existing demo-tree leaves remain navigable. No live inventory or progress is fabricated.

# section choose-layout
open "muqun:///settings-home-layout"
wait stable 400 5000

# section picker-ready
is visible "${TARGET}"

# section select-layout
press "${TARGET}"

# section picker-closed
is hidden "${TARGET}"

# section assert-visible
is visible "${TARGET}"

# section assert-hidden
is hidden "${TARGET}"

# section sixteen
open "muqun:///?homeContinueFixture=16"
wait stable 400 5000

# section hidden-match
scroll top
scroll down 0.2 --until "id=home-continue-search"
fill id="home-continue-search" "  HIDDEN   LEAF  "

# section no-match
scroll top
scroll down 0.2 --until "id=home-continue-search"
fill id="home-continue-search" "no-such-demo-session"

# section settle-typed
# This local search has no submit handler. End editing before scrolling so
# the software keyboard cannot cover the next query on a short display.
keyboard enter
wait stable 300 5000

# section settle-typed-ios
# Use the visible native Search key; the iOS Enter helper can time out after dispatch.
press "id=Search visible=true"
wait stable 300 5000

# section session-menu
# Search leaves exactly one demo row. The unsaved Demo computer has no recorded
# delete capability, so its menu must offer dismissal without a destructive action.
longpress "${TARGET}" 700
wait stable 300 5000

# section close-menu
press id="home-recent-close-menu"
wait stable 300 5000

# section clear
press "${TARGET}"
wait stable 300 5000

# section seek-up
scroll up 0.2

# section open-hidden-match
press "${TARGET}"

# section close-detail
back --system
wait absent "id=agent-subagent-detail-sheet" 10000

# section cleanup
open "muqun:///"
wait stable 400 5000
