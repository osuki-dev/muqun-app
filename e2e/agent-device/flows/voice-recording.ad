# A configured service enables native recording; cancel never uploads audio.

# section configure
wait "id=\"settings-voice-sheet\"" 10000
scroll down --until "id=\"voice-service-url\""
fill "id=\"voice-service-url\"" "https://example.invalid/custom/transcribe"
keyboard enter
fill "id=\"voice-service-key\"" "qa-placeholder-token"
keyboard enter
scroll down --until "id=\"voice-service-model\""
fill "id=\"voice-service-model\"" "qa-transcription"
keyboard enter
scroll down --until "id=\"voice-settings-save\""
press "id=\"voice-settings-save\""
wait "id=\"settings-voice-row\"" 5000
wait absent "id=\"settings-voice-sheet\"" 5000
back --system

# section record
wait "id=\"composer-send\"" 10000
# An empty draft can record, but an ordinary tap must not start recording.
press "id=\"composer-send\""
is hidden "id=\"voice-recording-stop\""
longpress "id=\"composer-send\"" 700
wait "id=\"voice-visual-recording\"" 15000 --allow-microphone-prompt
is visible "id=\"voice-recording-stop\""
wait "id=\"voice-inline-panel\"" 10000
is hidden "id=\"terminal-composer-input\""
wait "id=\"voice-recording-meter\"" 10000
screenshot "shots/voice-recording.png"
# The inline stop action finishes recording. The isolated invalid service fails safely.
press "id=\"voice-recording-stop\""
wait "label=\"Try again\"" 20000
is visible "id=\"voice-visual-error\""
screenshot "shots/voice-error.png"
is visible "id=\"voice-recording-stop\""
press "id=\"voice-recording-cancel\""
# The mounted draft returns before the voice panel's exit animation completes.
wait absent "id=\"voice-inline-panel\"" 10000
wait "id=\"terminal-composer-input\"" 10000
is hidden "id=\"voice-recording-stop\""
# A populated draft survives holding Send and cancelling; it is never sent.
fill "id=\"terminal-composer-input\"" "Keep this voice recording draft"
longpress "id=\"composer-send\"" 700
wait "id=\"voice-visual-recording\"" 15000
press "id=\"voice-recording-cancel\""
wait absent "id=\"voice-inline-panel\"" 10000
wait "id=\"terminal-composer-input\"" 10000
is visible "id=\"terminal-composer-input\" value=\"Keep this voice recording draft\""

# section back
# Android Back cancels the inline recording without leaving this composer.
longpress "id=\"composer-send\"" 700
wait "id=\"voice-visual-recording\"" 15000
back --system
wait absent "id=\"voice-inline-panel\"" 10000
wait "id=\"terminal-composer-input\" value=\"Keep this voice recording draft\"" 10000
is hidden "id=\"voice-inline-panel\""

# section clear
wait "id=\"settings-voice-sheet\"" 10000
scroll down --until "id=\"voice-settings-clear\""
press "id=\"voice-settings-clear\""
wait "label=\"Voice to text disabled\"" 5000
back --system
