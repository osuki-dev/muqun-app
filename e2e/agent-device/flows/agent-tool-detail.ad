# A tool call opened whole from a transcript's tool row, through the demo fixture.

# section open
open "muqun://agent-session-tree?rootAsid=demo-tree-root"
wait stable 400 5000

# section open-branch
press "${TARGET}"

# section transcript-visible
is visible "${TARGET}"

# section open-tool
press "${TARGET}"

# section hidden
is hidden "${TARGET}"

# section compact-task
# The child's own Idle status must win over Completed dispatch metadata.
# Duration absence is checked by the manifest matcher, including combined labels.
is hidden "id=agent-tool-open-detail"
is hidden "id=agent-tool-open-child"
is hidden "text=\"Demo researcher\""
snapshot
screenshot "shots/tool-task-compact.png"

# section expanded-task
wait "id=agent-tool-open-detail" 10000
is visible "id=agent-tool-open-child"
is visible "text=\"Demo researcher\""
is visible "text=\"research · Nested investigation\""
snapshot
screenshot "shots/tool-task-expanded.png"
# Consecutive toggles must end expanded with the real child state and action intact.
press "id=agent-tool-toggle label=\"research · Nested investigation · Idle · Collapse tool call\""
press "id=agent-tool-toggle label=\"research · Nested investigation · Idle · Expand tool call\""
is visible "id=agent-tool-toggle label=\"research · Nested investigation · Idle · Collapse tool call\""
is visible "id=agent-tool-open-child"
is visible "text=\"Demo researcher\""
snapshot
screenshot "shots/tool-task-retoggled.png"

# section task-expanded-restored
is visible "id=agent-tool-open-detail"
is visible "id=agent-tool-open-child"
is visible "text=\"Demo researcher\""
snapshot
screenshot "shots/tool-task-expanded-restored.png"

# section task-collapsed-restored
is hidden "id=agent-tool-open-detail"
is hidden "id=agent-tool-open-child"
is hidden "text=\"Demo researcher\""
snapshot
screenshot "shots/tool-task-collapsed-restored.png"

# section dispatch-detail-shot
snapshot
screenshot "shots/tool-dispatch-details.png"

# section open-child
# Expand inline to reveal identity and the session action, without opening dispatch details.
press "id=agent-tool-toggle label=\"research · Nested investigation · Idle · Expand tool call\""
wait "id=agent-tool-open-child" 10000
is visible "text=\"Demo researcher\""
press "id=agent-tool-open-child"
wait "id=agent-subagent-detail-transcript" 10000
is visible "text=\"Nested investigation\""
is visible "id=agent-subagent-detail-status label=Idle"
wait "text=\"Snapshot output for demo-tree-nested.\"" 5000
snapshot
screenshot "shots/tool-child-session.png"
back --system
wait "id=agent-session-tree-row-demo-tree-branch" 10000

# section open-logs
open "muqun://agent-subagent-detail?asid=demo-tree-leaf-20"
wait "id=agent-subagent-detail-transcript" 10000
wait stable 400 5000

# section log-collapsed
is hidden "id=agent-tool-open-detail"
snapshot
screenshot "shots/tool-${TOOL_NAME}-collapsed.png"

# section log-expanded
is visible "id=agent-tool-open-detail"
snapshot
screenshot "shots/tool-${TOOL_NAME}-expanded.png"
# No sleeps between toggles: catch stale expansion state without changing fixture content.
press "id=agent-tool-toggle label=\"${TOOL_HEADER} · ${TOOL_DURATION} · Collapse tool call\""
press "id=agent-tool-toggle label=\"${TOOL_HEADER} · ${TOOL_DURATION} · Expand tool call\""
press "id=agent-tool-toggle label=\"${TOOL_HEADER} · ${TOOL_DURATION} · Collapse tool call\""
press "id=agent-tool-toggle label=\"${TOOL_HEADER} · ${TOOL_DURATION} · Expand tool call\""
is visible "id=agent-tool-toggle label=\"${TOOL_HEADER} · ${TOOL_DURATION} · Collapse tool call\""
is visible "id=agent-tool-open-detail"
is visible "text=\"${TOOL_OUTPUT}\""
snapshot
screenshot "shots/tool-${TOOL_NAME}-retoggled.png"

# section log-restored
is hidden "id=agent-tool-open-detail"
snapshot
screenshot "shots/tool-${TOOL_NAME}-collapsed-restored.png"

# section log-detail-shot
snapshot
screenshot "shots/tool-${TOOL_NAME}-details.png"

# section read-preview
# Native pixels are retained for comparison with the existing bundled image;
# the image action's presence alone does not establish decoding.
wait "label=\"QA read image\"" 10000
is visible "label=\"QA read image\""
snapshot
screenshot "shots/tool-read-before-preview.png"
press "label=\"QA read image\""
wait "label=\"Close preview\"" 10000
wait stable 400 5000
is hidden "text=\"This image could not be loaded.\""
snapshot
screenshot "shots/tool-read-image-preview.png"
press "label=\"Close preview\""
wait "id=agent-subagent-detail-transcript" 10000
is hidden "label=\"Close preview\""
is visible "id=agent-tool-toggle label=\"read · 53ms · Collapse tool call\""
is visible "text=QA_READ_IMAGE_OUTPUT"
is visible "label=\"QA read image\""
wait stable 400 5000
snapshot
screenshot "shots/tool-read-preview-close-return.png"

# section read-preview-back
# Android Back must dismiss the native modal, not navigate out of the sheet.
press "label=\"QA read image\""
wait "label=\"Close preview\"" 10000
wait stable 400 5000
snapshot
screenshot "shots/tool-read-image-preview-back.png"
back --system
wait "id=agent-subagent-detail-transcript" 10000
is hidden "label=\"Close preview\""
is visible "id=agent-tool-toggle label=\"read · 53ms · Collapse tool call\""
is visible "text=QA_READ_IMAGE_OUTPUT"
is visible "label=\"QA read image\""
wait stable 400 5000
snapshot
screenshot "shots/tool-read-preview-back-return.png"

# section sheet-visible
is visible "${TARGET}"

# section status
is visible "${TARGET}"

# section input
is visible "${TARGET}"

# section copy-input
press "${TARGET}"

# section close-tool
back --system

# section transcript-restored
is visible "${TARGET}"

# section close-detail
back --system

# section close-tree
back --system
