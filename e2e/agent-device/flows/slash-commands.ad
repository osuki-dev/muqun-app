# section s30
# A dismissed trigger stays dismissed while edited in place. Remove it first;
# Android's atomic fill is not proof that React observed a trigger-free draft.
# agent-device rejects empty/blank fills; ordinary draft text removes the query.
fill id="terminal-composer-input" "draft"
is visible "id=\"terminal-composer-input\" value=\"draft\""
fill id="terminal-composer-input" "/mod" --delay-ms 80

# section insert-cleared-model
press id="terminal-composer-input"
type "/mod" --delay-ms 80

# section verify-model
is visible "id=\"terminal-composer-input\" value=\"/mod\""

