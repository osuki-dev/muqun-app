# Query, insert without sending, dismiss, and leave ordinary text alone.
# One representative query per path keeps native acceptance focused.
fill id="terminal-composer-input" "/co"
wait "label=\"Insert /compact [instructions]\"" 10000
is hidden "label=\"Insert /clear\""
fill id="terminal-composer-input" "/rel"
wait "label=\"Insert /release-notes\"" 10000
is hidden "label=\"Insert /compact [instructions]\""
press "label=\"Insert /release-notes\""
wait "id=terminal-composer-input value=\"/release-notes \"" 10000
is hidden "id=slash-command"
is visible "label=\"Send to agent\""
# Removing the trigger resets dismissal without depending on native key events.
fill id="terminal-composer-input" "draft"
fill id="terminal-composer-input" "/mod"
wait "label=\"Insert /model [model]\"" 10000
press "label=\"Close the command list\""
is hidden "id=slash-command"
fill id="terminal-composer-input" "look at /rel"
is hidden "id=slash-command"
