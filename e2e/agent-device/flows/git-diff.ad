# Native agent-device action sections; suite.json composes guards and includes.
# git-diff

# section s1
press "${TARGET}"

# section s2
is visible "${TARGET}"

# section s3
wait stable 400 8000

# section s5
screenshot "shots/20-changes.png"

# The status groups and the checkout chips: the demo repository has staged,
# unstaged and untracked files and a second linked checkout. Switching reads
# that checkout's one file, and switching back lands on the groups again.
# section s5a
is visible "${TARGET}"

# section s5b
press "${TARGET}"

# section s5c
wait stable 400 15000

# section s5d
is visible "${TARGET}"

# section s5e
press "${TARGET}"

# section s5f
wait stable 400 15000

# section s5g
is visible "${TARGET}"
scroll down 0.2 --until "id=agent-changes-file-src/lib/demo-terminal-history.ts"

# section s6
press "${TARGET}"

# section s7
wait stable 400 15000

# section s11
screenshot "shots/21-changes-expanded.png"

# section s12
# Progress by the visible viewport rather than a small physical-pixel distance.
# The manifest still stops only when the actual Show more row is visible.
scroll down 0.75

# section s12-ipad
# Start inside the diff's own scroll viewport rather than at the generic
# scroll's y=751. The Changes sheet is full-screen on a Pad, so this point is
# well inside the diff; it was chosen when the sheet was a centred card whose
# bottom edge sat above y=751.
gesture pan 605 550 0 -300 400
wait stable 300 5000

# section s13
press "${TARGET}"

# section s14
wait stable 400 15000

# section s17
press "${TARGET}"

# section s18
wait stable 400 8000

# section s19
is visible "${TARGET}"

# section s20
# A form sheet has no X circle: the grabber and the swipe are the close, so
# the flow dismisses it the way a reader does. On a Pad the sheet is
# full-screen and the runner's `back` presses its `sheet-close` button on iOS
# (Android's back pops it). The manifest's next step asserts the terminal's
# own entry point is back.
back --system

# section s21
is visible "${TARGET}"
