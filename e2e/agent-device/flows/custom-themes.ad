# Native actions only. Complete fictional color theme; no network, gateway or user data.

# section press
press "${TARGET}"

# section visible
is visible "${TARGET}"

# section scroll
scroll down --pixels 300

# section install
# Paste JSON is gone, and with it the only offline, deterministic way a custom
# theme could reach this app: the two routes that remain are a system file
# picker and the network gallery, and this suite is required to run with
# neither. So the theme comes from the document the demo workspace already
# ships, and this flow applies it, which is what puts a custom theme in the
# library for everything below to work on.
#
# Raw selectors rather than manifest targets: closing the viewer is addressed by
# accessibility label, and the manifest's target vocabulary is text and id only.
press "id=terminal-open-files"
wait stable 400 5000
scroll down 0.2 --until "text=\"Open muqun.muqun-theme.json\""
press "text=\"Open muqun.muqun-theme.json\""
wait "id=custom-theme-preview" 15000
# Opening a valid theme goes straight to preview; applying remains explicit.
# Seek the confirm by identity; it may already fit below the preview.
scroll down --until "id=theme-apply"
is visible "id=theme-apply"
press "id=theme-apply"
# Applying from the file viewer goes home in one move under the reskin cover:
# the viewer and the files sheet close with it, so nothing is left to dismiss.
wait "text=\"Settings\"" 20000
wait stable 400 5000

# section install-back
# Phones return to Home here; tablets reach Settings through the retained rail.
press "${TARGET}"
wait stable 400 5000

# section settle
wait stable 400 5000

# section applied-status
# Applying is a confirmation: the screen leaves, exactly as choosing a built-in
# pack does. The theme is then reachable again from the list it was added to.
is hidden "id=\"theme-apply\""
screenshot dist/theme-applied-status.png

# section reopen-applied
# The old flow arrived here on Home, because applying from the detail route
# unwinds the root stack, and had to walk back in through Settings and the
# picker. This one applied from the file viewer and walked to Settings itself,
# so it is already in the picker: the way into the detail route is the row the
# install added, and nothing before it. The property under test is unchanged --
# a theme that has just been applied is still reachable from the list it joined.
#
# By testID, because the card and the current-theme bar above the grid both
# carry the theme's name, so neither the name nor the name plus a role
# identifies the card.
press "id=theme-row-my-theme"
wait stable 400 5000
is visible "id=\"custom-theme-preview\""

# section link-import
# The Import card's tap opens the card menu, where the manifest's press left it;
# the link route docks its field at the foot of the sheet.
press "id=theme-import-link"
is visible "id=theme-link-input"
is visible "id=theme-link-inspect"
press "id=theme-link-cancel"
is hidden "id=theme-link-input"
# The file route is a row of the same menu, so it is reached by opening it
# again; the dock's room left the grid at its end, so the card is found first.
scroll down --until "id=theme-import"
press "id=theme-import"
is visible "id=theme-import-file"
press "id=theme-menu-cancel"
is hidden "id=theme-import-file"

# section browse-entry
# The catalogue is the themes sheet's Gallery tab. Present, and deliberately
# not pressed *here*: the manifest drives the press that follows, so this file
# never spells it -- see `browse-offline` below for what the press is for.
is visible "id=theme-tab"

# section browse-offline
# The demo catalogue can supply this card offline; on an unpaired home the
# published catalogue supplies the same first entry over the normal transport.
wait "text=\"Acacia Afterglow\"" 15000
is visible "text=\"Acacia Afterglow\""
screenshot dist/theme-browse.png

# section browse-network-offline
# On phones, Settings is reached after leaving the demo workspace. The
# catalogue then uses the normal network transport; with Wi-Fi disabled it
# must explain the failure and offer a retry without downloading a package.
is visible "text=\"Could not reach the theme catalogue\""
is visible "text=\"TRY AGAIN\""
screenshot dist/theme-browse-network-offline.png

# section browse-closed
# Leaving the Gallery tab is a tab press on every device: the catalogue is no
# longer a sheet of its own, so there is nothing to dismiss.
wait stable 400 5000
is hidden "id=theme-browse-list"
is visible "id=theme-tab"

# section mine-tab
# The tab persists, and the suite relaunches without erasing data -- so a flow
# that relies on the default lands wherever the previous flow left it. Every
# assertion below names the tab it needs first.
wait stable 400 5000
is visible "id=theme-tab"
is visible "id=\"settings-selection:on:theme-tab-mine\""
# New imports append to the existing library. The suite preserves installed
# themes, so the fixture may be below the first screen on a reused QA device.
scroll down --until "id=theme-row-my-theme"
is visible "id=theme-row-my-theme"

# section builtin-tab
wait "id=\"settings-selection:on:theme-tab-builtin\"" 15000

# section opacity-enable
# This theme's palette leaves a terminal floor of 97%, so the whole track spans
# three points. Asserting an exact percentage after a tap measures where the tap
# landed on that track, not what the app did -- it reports 100% here. What is
# worth holding is that the control renders and states the floor the policy
# computed; the floor itself is asserted by the step that follows.
press "id=theme-terminal-opacity"
wait stable 400 5000
is visible "id=theme-terminal-opacity-value"

# section opacity-adjust
is visible "${TARGET}"

# section opacity-reset
press "id=theme-appearance-reset"
wait stable 400 5000
scroll up 0.2 --until "id=theme-terminal-opacity-value"
is visible "text=100%"

# section home-visibility
scroll down 0.2 --until "id=theme-show-home-logo"
press "id=theme-show-home-logo"
scroll down 0.2 --until "id=theme-show-home-text"
press "id=theme-show-home-text"
wait stable 400 5000
# The reset control appears once a preference is custom, but it sits under the
# hero segmented control and below this route's pinned DONE bar -- a bare
# visibility check here has been failing on an off-screen node since long
# before the sheet redesign. The manifest's next step is a bounded
# scroll-to-visible for the same id, which proves it appeared and leaves it
# reachable for `opacity-reset` to press.

# section back-to-library
# Return from the detail editor before continuing to Settings storage checks.
press "id=custom-theme-back"
wait "id=theme-row-my-theme" 10000

# section return-settings
# Keep the applied theme installed for the Storage checks below. The inline
# action's controlled two-step contract has focused source coverage; driving
# both taps through separate native captures can consume its intentional
# four-second window before the second tap is delivered.
back --in-app
wait "id=settings-theme-row" 10000

# section settings-scroll-up
# The manifest keeps seeking the same row; stay inside the current viewport
# and use the form sheet's scroll surface on iPad.
scroll up 0.2 --in-sheet
wait stable 300 5000

# section settings-scroll-up-android
# Android's nested Settings grid responds to a drag through its content;
# the generic scroll may land on its outer scroll view and leave it at the foot.
gesture pan 450 1100 0 800 600
wait stable 300 5000

# section settings-scroll-up-android-tablet
# The tablet viewport is 2560x1600; keep the full drag inside its content.
gesture pan 1000 600 0 700 600
wait stable 300 5000

# section apply-builtin
# Applying is final: close the whole picker stack and reveal Home.
press "${TARGET}"
wait stable 400 5000

# section applied-home
wait absent "id=settings-theme-sheet" 10000
wait "text=\"Settings\"" 10000
is visible "text=\"Settings\""

# section selected-builtin
# Successful selection must close, and reopening must show the actual active
# row. The durable-write failure/retry path requires a separate QA fault build.
wait absent "id=settings-theme-sheet" 10000
press "id=settings-theme-row"
wait "id=settings-theme-sheet" 10000
press "id=\"settings-selection:on:theme-tab-builtin\""
scroll down --until "id=\"settings-selection:on:theme-osuki\""
is visible "id=\"settings-selection:on:theme-osuki\""
screenshot "shots/theme-osuki-selected.png"
back --system
wait absent "id=settings-theme-sheet" 10000
is visible "label=\"Theme, Osuki\""

# section storage-anchor
# Where the taps below are made from, and never the position the flick above
# happened to stop at. A scroll that stops the moment a row enters the tree
# leaves it against the bottom edge, and the press that follows lands on the
# navigation bar rather than the row -- the settings flow measured that at
# y=2398 on a 1080x2400 device. `scroll bottom` is a position the list always
# has, whatever is in it. On an Android tablet the Settings list stays in the
# tree beside the sheet, so the runner flicks inside the sheet (`--in-sheet`).
scroll bottom --in-sheet
wait stable 400 5000

# section storage-visible
# The row states its own state: `SettingsNavRow` composes its label and detail
# into one accessibility label, so `0 themes · 0 B` is what a disabled row says
# and the manifest asserts that rather than a disabled flag the native matcher
# does not carry.
is visible "${TARGET}"

# section storage-press
press "${TARGET}"

# section storage-settle
# Removal is one durable library write per theme, each handing the frame back
# before the next, and then a fresh walk of the theme directory to fill the
# size in again. The assertion after this step carries its own timeout for it.
wait stable 400 5000
