# The ordinary offline AgentWorkbench and AgentComposer, without sending a prompt.
# section menu
open "muqun://agent?asid=demo-compaction-layout&agentId=opencode"
wait "id=agent-composer-input" 15000
is visible "id=agent-composer-action-row"
# Context loads asynchronously and inserts its control before Command.
# Wait for that known fixture control before resolving a tap coordinate.
wait "id=agent-composer-tokens-pill" 10000
wait stable 400 5000
press "id=agent-composer-commands"
wait "id=agent-composer-command-menu" 5000
is visible "id=agent-composer-command-web"
is visible "id=agent-composer-command-simulator"
snapshot
screenshot "shots/agent-session-command-menu.png"
# The demo has no paired transport proof. The route must keep its own gate.
press "id=agent-composer-command-simulator"
wait "id=simfarm-pair" 10000
press "id=simfarm-close"
wait "id=agent-composer-input" 10000
# section triggers
# Re-focus the real input after the native simulator sheet relinquishes focus.
press "id=agent-composer-input"
fill "id=agent-composer-input" "@"
wait "id=file-mention-app.json" 10000
wait 400
is visible "id=agent-composer-input value=@"
snapshot
screenshot "shots/agent-composer-files.png"
press "id=file-mention-app.json"
wait absent "id=file-mention-app.json" 5000
is visible "id=agent-composer-input value=\"app.json \""
fill "id=agent-composer-input" "$"
wait "id=skill-offline-review" 10000
wait 400
is visible "id=agent-composer-input value=$"
snapshot
screenshot "shots/agent-composer-skills.png"
press "id=skill-offline-review"
wait absent "id=skill" 5000
is visible "id=agent-composer-input value=\"$offline-review \""
fill "id=agent-composer-input" "/"
# This recipient returns no native commands. The app must not invent shortcuts.
wait absent "id=slash-command" 5000
wait 400
is visible "id=agent-composer-input value=/"
snapshot
screenshot "shots/agent-composer-commands.png"
fill "id=agent-composer-input" ""
wait absent "id=slash-command" 5000

# The exact offline fixture streams for real elapsed time, then reports a
# structured synthetic error. No live agent request or prompt is sent.
open "muqun:///"
open "muqun://agent?asid=demo-compaction-log-failed&agentId=opencode"
wait "id=agent-composer-tokens-pill" 15000
press "id=agent-composer-tokens-pill"
wait "id=agent-context-sheet" 10000
scroll down --until "id=agent-context-compact-btn"
press "id=agent-context-compact-btn"
wait absent "id=agent-context-sheet" 10000
wait "id=agent-compaction-error" 50000
is visible "id=agent-compaction-error label=\"Offline QA compaction failed: synthetic provider rejected the request.\""
press "id=agent-composer-compaction-pill"
wait "id=agent-compaction-details" 10000
is visible "id=agent-compaction-error"
screenshot "shots/compaction-failure-details.png"
open "muqun:///"
