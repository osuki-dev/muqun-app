# The selected server's task ledger, opened by deep link against the demo fixtures.

# section open
open "muqun://server-tasks"
wait stable 400 5000

# section visible
is visible "${TARGET}"

# section row-working
is visible "${TARGET}"

# section row-waiting
is visible "${TARGET}"

# section open-detail
press "${TARGET}"

# section detail-visible
is visible "${TARGET}"

# section cancel-arm
press "${TARGET}"

# section cancel-confirm
press "${TARGET}"

# section detail-cancelled
is visible "${TARGET}"

# section back-to-list
press "${TARGET}"

# section row-cancelled
is visible "${TARGET}"

# section close
back --system

# section closed
is hidden "${TARGET}"
