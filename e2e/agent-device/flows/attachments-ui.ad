# Native agent-device action sections; suite.json composes guards and includes.
# attachments-ui

# section s1
is visible "${TARGET}"

# section s2
is visible "${TARGET}"

# section s3
is hidden "${TARGET}"

# section s4
is hidden "${TARGET}"

# section s5
is hidden "${TARGET}"

# section s6
is hidden "${TARGET}"

# section s7
press "${TARGET}"

# section s8
press "${TARGET}"

# section choose-agent
press "${TARGET}"

# section s9
fill id="terminal-composer-input" "/comp"

# section s10
is visible "${TARGET}"

# section s11
is visible "${TARGET}"

# section s12
press "${TARGET}"

# section s13
wait stable 400 5000

# section s14
is hidden "${TARGET}"

# section s15
is visible "${TARGET}"

# section artifact-image-preview
# Reused by artifacts after its existing image filter assertion. This opens the
# bundled bytes, not a photo picker or a user's files. Pixels require review of
# the retained screenshot; a close button alone does not prove image decoding.
press "label=\"Open settings-dark.png\""
wait "label=\"Close preview\"" 10000
wait stable 400 5000
is hidden "text=\"This image could not be loaded\""
is hidden "text=\"This image could not be loaded.\""
snapshot
screenshot "shots/artifact-image-preview.png"
press "label=\"Close preview\""
wait absent "label=\"Close preview\"" 10000
wait "label=\"Refresh files\"" 10000
is visible "label=\"Open settings-dark.png\""

# section message-galleries
# Synthetic offline bitmaps exercise the production message/album/lightbox paths.
open "muqun://agent-subagent-detail?asid=demo-image-gallery-5&sessionId=demo"
wait "id=message-image-album-3-columns" 10000
wait "label=\"QA gallery 3\"" 10000
wait stable 400 5000
snapshot
screenshot "shots/message-gallery-five.png"
press "label=\"QA gallery 3\""
wait "id=image-preview-page-2" 10000
is visible "id=image-preview-page-2"
is hidden "id=image-preview-page-0"
is hidden "text=\"This image could not be loaded.\""
screenshot "shots/message-gallery-third-preview.png"
press "id=image-preview-close"
wait absent "id=image-preview-close" 10000
is visible "id=message-image-album-3-columns"
back --system

open "muqun://agent-subagent-detail?asid=demo-image-gallery-2&sessionId=demo"
wait "id=message-image-album-2-columns" 10000
wait "label=\"QA gallery 2\"" 10000
screenshot "shots/message-gallery-two.png"
press "label=\"QA gallery 2\""
wait "id=image-preview-page-1" 10000
is visible "id=image-preview-page-1"
press "id=image-preview-close"
wait absent "id=image-preview-close" 10000
back --system

open "muqun://agent-subagent-detail?asid=demo-image-gallery-1&sessionId=demo"
wait "label=\"QA gallery 1\"" 10000
is hidden "id=message-image-album-2-columns"
is hidden "id=message-image-album-3-columns"
screenshot "shots/message-gallery-single.png"
back --system

open "muqun://agent-subagent-detail?asid=demo-image-attachments-5&sessionId=demo"
wait "id=message-image-album-3-columns" 10000
wait stable 400 5000
snapshot
screenshot "shots/message-attachments-five.png"
back --system
