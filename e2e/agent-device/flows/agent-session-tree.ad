# Recursive OpenCode session tree, reached through the bundled demo fixture.

# section open
open "muqun://agent-session-tree?rootAsid=demo-tree-root"
wait stable 400 5000

# section visible
is visible "${TARGET}"

# section scroll
# Cover most of the visible list on every pass, independent of device density.
# The manifest checks the exact leaf before each gesture and keeps a fixed budget.
scroll down 0.7

# section open-detail
press "${TARGET}"

# section detail-visible
is visible "${TARGET}"

# section detail-output
is visible "${TARGET}"

# section detail-model
is visible "${TARGET}"

# section detail-tokens
is visible "${TARGET}"

# section close-detail
back --system

# section tree-restored
is visible "${TARGET}"

# section close-tree
back --system

# section closed
is hidden "${TARGET}"
