# Recursive OpenCode session tree, reached through the bundled demo fixture.

# section open
open "muqun://agent-session-tree?rootAsid=demo-tree-root"
wait stable 400 5000

# section visible
is visible "${TARGET}"

# section root-and-child
# The manifest checks the actual mode/status captions before retaining pixels.
# Its regex matcher handles Android's combined label and iOS's separate value.
snapshot
screenshot "shots/session-tree-root-child-caption.png"

# section branch-detail
press "id=agent-session-tree-row-demo-tree-branch"
wait "id=agent-subagent-detail-transcript" 10000
is visible "text=\"Research branch\""
is visible "id=agent-subagent-detail-status label=Idle"
wait "text=\"Snapshot output for demo-tree-branch.\"" 10000
is visible "text=\"Snapshot output for demo-tree-branch.\""
# The legacy Codex activity has four null input fields but no returned result.
# It must explain the missing inline result and keep the real conversation reachable.
press "id=agent-tool-toggle"
wait "id=agent-subagent-activity-body" 5000
is visible "text=\"This activity has no result attached. Open session to read the conversation\""
press "id=agent-tool-open-child"
wait "text=\"Snapshot output for demo-tree-nested.\"" 10000
# OpenCode's actual subagent result remains inline, without its wire envelope.
press "id=agent-tool-toggle"
wait "text=\"QA_SUBAGENT_RESULT: The parser review found an ordering issue.\"" 5000
is hidden "id=agent-subagent-activity-body"
back --system
wait absent "id=agent-subagent-detail-sheet" 10000
wait "id=agent-session-tree-row-demo-tree-branch" 10000
is visible "id=agent-session-tree-row-demo-tree-root"
is visible "id=agent-session-tree-row-demo-tree-branch"

# section scroll
# Cover most of the visible list on every pass, independent of device density.
# The manifest checks the exact leaf before each gesture and keeps a fixed budget.
scroll down 0.7

# section open-detail
press "${TARGET}"

# section detail-visible
is visible "${TARGET}"

# section detail-output
is visible "${TARGET}"

# section detail-model
is visible "${TARGET}"

# section detail-tokens
is visible "${TARGET}"

# section close-detail
back --system
wait absent "id=agent-subagent-detail-sheet" 10000
wait "id=agent-session-tree-sheet" 10000

# section tree-restored
is visible "${TARGET}"

# section close-tree
back --system
wait absent "id=agent-session-tree-sheet" 10000
wait "id=terminal-composer-input" 10000

# section closed
is hidden "${TARGET}"

# section context-ownership
# Use the ordinary workbench, not the standalone streaming transcript fixture.
# The composer's context pill is addressed by id: the session title header
# differs between phone and Pad, and the tree snapshot backend can lift labels.
open "muqun://agent?asid=demo-compaction-layout&agentId=opencode"
wait "id=agent-composer-tokens-pill label=\"Context 4% full\"" 15000
wait stable 600 5000
# The development warning overlay can intercept the bottom composer controls.
react-native dismiss-overlay
press "id=agent-composer-tokens-pill"
wait "id=agent-context-sheet" 10000

# section context-owner-retained
# The manifest checks the token count on agent-context-used by prefix, so the
# sentence around it can change without breaking the ownership check, and the
# model and project by text, which also matches the rows' accessibility values.
screenshot "shots/context-owner-retained.png"
back --system
wait absent "id=agent-context-sheet" 10000
is visible "id=agent-composer-tokens-pill label=\"Context 4% full\""
wait stable 600 5000
press "id=agent-composer-tokens-pill"
wait "id=agent-context-sheet" 10000

# section context-closed
back --system
wait absent "id=agent-context-sheet" 10000
is visible "id=agent-composer-tokens-pill"
