# Native agent-device action sections; suite.json composes guards and includes.
# pad-workspace

# section s1
press "${TARGET}"

# section s2
wait stable 400 5000

# section s3
press "${TARGET}"

# section s4
is visible "${TARGET}"

# section s5
is visible "${TARGET}"

# section s6
is hidden "${TARGET}"

# section s7
is visible "${TARGET}"

# section s8
is visible "${TARGET}"

# section s9
is visible "${TARGET}"

# section s10
is visible "${TARGET}"

# section s11
press "${TARGET}"

# section s12
wait stable 400 5000

# section s13
is visible "${TARGET}"

# section s14
is hidden "${TARGET}"

# section s15
press "${TARGET}"

# section s16
is visible "${TARGET}"

# section s17
is hidden "${TARGET}"

# section s18
press "${TARGET}"

# section open-editor-picker
press "${TARGET}"

# section s19
is visible "${TARGET}"

# section s20
is hidden "${TARGET}"

# section home-navigation
# Back restores Home across the whole window; the workspace stays retained.
is visible "role=button label=\"Back to Home\""
press "id=\"pad-server-rail-back\""
wait "id=\"home-overview-overlay\"" 10000
wait stable 400 5000
is visible "id=\"home-pad-toolbar-actions\""
is hidden "id=\"server-agent-pane-1\""
is visible "id=\"home-pad-launch-pane\""
is visible "id=\"home-pad-lower-band\""
is visible "text=\"Pair your first computer\""
wait "role=button label=\"Settings\" hittable=true" 10000

# section home-settings-ios
press "role=button label=\"Settings\" hittable=true"

# section home-settings-android
press "role=button label=\"Settings\"" --within-id home-overview-overlay

# section home-settings-return
wait text "Computers" 10000
is visible "role=button label=\"Go back\""
back --system
wait "id=\"home-pad-launch-pane\"" 10000

# section home-navigation-connect
# Demo mode is transient and never appears among saved computers.
press "role=button label=\"Try the demo\""
wait absent "id=\"home-overview-overlay\"" 10000
wait "id=\"pad-server-rail-container\"" 10000
is visible "label=\"Switch to nvim\""
