# Native agent-device action sections; suite.json composes guards and includes.
# pad-workspace

# section s1
press "${TARGET}"

# section s2
wait stable 400 5000

# section s3
press "${TARGET}"

# section s4
is visible "${TARGET}"

# section s5
is visible "${TARGET}"

# section s6
is hidden "${TARGET}"

# section s7
is visible "${TARGET}"

# section s8
is visible "${TARGET}"

# section s9
is visible "${TARGET}"

# section s10
is visible "${TARGET}"

# section s11
press "${TARGET}"

# section s12
wait stable 400 5000

# section s13
is visible "${TARGET}"

# section s14
is hidden "${TARGET}"

# section s15
press "${TARGET}"

# section s16
is visible "${TARGET}"

# section s17
is hidden "${TARGET}"

# section s18
press "${TARGET}"

# section open-editor-picker
press "${TARGET}"

# section s19
is visible "${TARGET}"

# section s20
is hidden "${TARGET}"

# section home-navigation
# Home and task share one persistent navigation rail.
press "id=\"pad-server-rail-workbench\""
wait "id=\"home-overview-overlay\"" 10000
wait stable 400 5000
is visible "id=\"pad-server-rail-container\""
is hidden "id=\"server-agent-pane-1\""
is hidden "label=\"Show the server list\""
is visible "role=button label=\"Home\""
is visible "id=\"home-pad-launch-pane\""
is visible "text=\"Pair your first server\""
press "role=button label=\"Settings\""
wait text "SERVERS" 10000
is visible "role=button label=\"Go back\""
back --system
wait "role=button label=\"Home\"" 10000
press "id=\"home-connection-gateway-muqun-demo\""
wait absent "id=\"home-overview-overlay\"" 10000
wait "id=\"pad-server-rail-container\"" 10000
is hidden "id=\"home-overview-overlay\""
is visible "label=\"Switch to nvim\""
