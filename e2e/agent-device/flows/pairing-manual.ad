# Native agent-device action sections; suite.json composes guards and includes.
# pairing-manual
#
# Pairing is a native form sheet. There is no "Close pairing" button left to
# press -- the grabber and the swipe are the close -- so this flow never leaves
# the sheet: it toggles between the scanner and the two entry modes and ends on
# the install command. The manifest asks for the field by its label, and the
# label is sentence case because a scene field's label is a caption rather than
# the kit's 11pt uppercase `label` role.

# section s1
press "${TARGET}"
wait stable 400 5000
# Expand the phone sheet and reveal the controls below the tablet viewfinder.
scroll down --pixels 160 --duration-ms 300
wait stable 400 5000

# section s2
is visible "${TARGET}"

# section s3
is visible "${TARGET}"

# section s4
is hidden "${TARGET}"

# section s5
press "${TARGET}"

# section s6
is visible "${TARGET}"

# section s7
is visible "${TARGET}"

# section s8
is hidden "${TARGET}"

# section s9
press "${TARGET}"

# section s10
is visible "${TARGET}"

# section s11
is hidden "${TARGET}"

# section s12
press "${TARGET}"

# section s13
is visible "${TARGET}"

# section s14
press "${TARGET}"
wait stable 400 5000
# The scanner is taller than the manual form; bring its last action into view.
scroll down --pixels 160 --duration-ms 300
wait stable 400 5000

# section s15
is visible "${TARGET}"

# section s16
press "${TARGET}"

# section s17
is visible "${TARGET}"

# section scroll-controls
scroll down --pixels 160 --duration-ms 300
wait stable 400 5000
