# section reset-theme
# The tile declares `accessibilityRole="radio"`, which this runtime reports as
# a cell, so `role=radiobutton` never matches. The bare label matches the text
# inside the tile as well as the tile, so the role is what separates them.
press "role=cell label=\"Osuki\""
wait stable 400 5000
press "label=\"Theme, Osuki\""

