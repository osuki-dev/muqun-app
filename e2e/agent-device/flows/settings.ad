# section quick-actions-bottom
# The anchor the two nudges below are measured from. `scroll bottom` is a
# position the list always has, whatever is in it, which is the only reason the
# nudges can be a fixed number of pixels at all.
scroll bottom
wait stable 400 5000

# section quick-actions-seek
# Walk back up until the Quick actions row is in the tree again.
#
# This used to be part of the anchor: the nudges below were measured as a
# distance from the bottom of the list, because the row happened to be one
# screen above it. STORAGE then landed between SECURITY and ABOUT and put
# another 832px underneath the row, and a fixed distance from the bottom
# stopped naming it -- the flow tapped an empty part of ABOUT and failed two
# steps later looking for a sheet that never came. A distance from the bottom
# of a growing list is not a description of a row in the middle of it.
#
# So the seek is a loop rather than a number, and what it restores is the
# *precondition* the two nudges were measured against rather than a distance:
# the row just back inside the top edge. `scroll up --pixels 160 --duration-ms 300` is the
# flick the rest of this flow uses; measured here, each one moves the list
# about 409px, and the first one that brings the row back lands it at
# y=22..188 -- the y=32..198 the Android nudge was calibrated on.
scroll up --pixels 160 --duration-ms 300
wait stable 300 5000
wait stable 400 5000

# section quick-actions-seek-android-phone
gesture pan 450 1050 0 600 500
wait stable 400 5000

# section quick-actions-seek-android-tablet
gesture pan 900 700 0 300 400
wait stable 400 5000

# section s89
# The iOS nudge, from the precondition the seek above restores.
#
# Tapping the row where the seek leaves it does not work: it settles at y=-20,
# just above the top edge, and a tap on its clamped centre hits the status bar
# -- which on iOS scrolls the list to the top and loses it outright.
#
# Measured on this runtime: from y=-20, one `scroll up --pixels 60` puts the
# row at y=414. `--pixels` is a gesture magnitude rather than a literal delta,
# so 96 and above carry it straight back out of the tree.
scroll up --pixels 60

# section s89-android
# Android's own calibration of the step above, kept apart rather than merged.
# `scroll up --pixels 60` is a flick, and its magnitude does not mean the same
# thing on both runtimes: on iOS it lands the row at y=414, on Android it leaves
# it at y=32..198 -- overlapping the app's floating header (y=158..279) and
# hard against the status bar, so the tap that follows opens nothing and the
# flow fails two steps later looking for a sheet that never came.
#
# `gesture pan` is a drag rather than a flick, so its delta is the delta.
# Measured here on a Pixel 8 emulator at 1080x2400: from y=32..198, panning
# down 400 moves the row to y=403..569, which clears the header with room to
# spare.
gesture pan 540 800 0 400 400
wait stable 400 5000

# section clear-native-header
# Settle only. This used to scroll up to lift the row clear of the native
# large-title header, back when the step above overshot and left it at y=-20.
# That step is now a seek plus one small measured nudge, so the row arrives
# where it is reachable and any further scrolling here only carries it straight
# back out of the tree.
wait stable 400 5000

# section s90
press "${TARGET}"

# section s91
is visible "${TARGET}"

# section s92
# The caption under the title, which is what a sheet with no close button has
# instead of a second thing to point at. The sheets lost their X circles when
# the app went to one sheet system: on a form sheet the grabber and the swipe
# are the close, so there is no "Close quick actions" control left to press.
is visible "${TARGET}"

# section s93
# Android's back dismisses a form sheet, which is the same gesture a reader has.
back --system

# section s94
is visible "${TARGET}"

# section s95
press "${TARGET}"

# section s96
is visible "${TARGET}"
