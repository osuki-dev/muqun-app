# section reset-theme
# Selected by testID, not by role. The tile declares
# `accessibilityRole="radio"`, and the two runtimes report that differently:
# iOS surfaces it as a cell, Android as `android.widget.RadioButton`. A flow
# that names either one passes on that platform and fails on the other, which
# is exactly what `role=cell` did here -- green on iOS for as long as nobody
# ran it on Android. The id carries the selection state, so the manifest
# matches it with the same `(on|off)` pattern the scroll steps already use.
press "${TARGET}"
wait stable 400 5000

# section confirm-reset
press "${TARGET}"

