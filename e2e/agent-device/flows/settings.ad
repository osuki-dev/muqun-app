# section storage-scroll
# STORAGE sits between SECURITY and ABOUT. Its four rows are within a screen of
# each other, so the ordinary flick is enough here: unlike the ALERTS heading in
# `s56`, every target below is a full row rather than a 13pt instrument label,
# and a flick that overshoots one of them still leaves it in the tree for the
# scroll-to-visible to come back to.
scroll down --pixels 160 --duration-ms 300
wait stable 300 5000

# section storage-seek
# The rows below STORAGE are sought UP from the bottom edge, never down into
# it. A downward seek parks the row against the bottom edge as an uncomposed
# stub -- in the tree, so the loop stops scrolling, but with no text for the
# visibility probe -- and the list is already at its bottom stop, so further
# downward flicks change nothing and the step times out. From `scroll bottom`
# every row below is composed (the anchor screenshot proves it), and each
# upward flick either reveals the target or overshoots above it, in which case
# the next iteration re-anchors and tries again: the loop always makes
# progress or resets, and can never wedge at the stop.
scroll bottom
wait stable 400 5000
scroll up --pixels 160 --duration-ms 300
wait stable 300 5000

# section storage-visible
is visible "${TARGET}"
is hidden "id=\"settings-storage-other-row\""

# section storage-press
press "${TARGET}"

# section storage-settle
# Clearing is several native round trips -- expo-image's two cache calls, then
# one directory delete per allow-listed entry -- and each one hands the frame
# back before the next, so the row returns to its idle state a little after the
# tap rather than on it. The recount that follows is what fills the size in
# again, and the assertion after this step carries its own timeout for that.
wait stable 400 5000

