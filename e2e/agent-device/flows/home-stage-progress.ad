# Explicit offline fixture; the normal Stage stores, followers and routes render it.

# section layout
open "muqun:///settings-home-layout"
wait stable 400 5000

# section press
press "${TARGET}"

# section start
open "muqun:///?stageProgressFixture=linked"
wait stable 600 5000
# Development warning banners can cover the dock; verify dismissal before input.
react-native dismiss-overlay

# section visible
is visible "${TARGET}"

# section hidden
is hidden "${TARGET}"

# section cleanup
open "muqun:///?stageProgressFixture=off"
wait stable 300 5000
open "muqun:///settings-home-layout"
wait stable 400 5000

# section home
open "muqun:///"
wait stable 300 5000

# section reply-menu
longpress "${TARGET}" 700
wait stable 300 5000

# section draft
fill id="home-composer-input" "Unsent Stage QA draft"
wait stable 300 5000

# section clear-draft
fill id="home-composer-input" ""
wait stable 400 5000

# section search-empty
fill id="home-continue-search" "NoMatchingStageSessionQA"
wait stable 300 5000

# section clear-search
fill id="home-continue-search" ""
keyboard enter
wait stable 300 5000
