# Independent offline main/child read snapshots; never use the compaction history.
# PROPOSAL ONLY: no native run or source review approval is implied.

# section host
open "${URL}"
wait stable 600 10000

# section question-and-task
scroll up --until "id=agent-tool-demo-preview-main-question-call"
is visible "id=agent-tool-demo-preview-main-question-call"
snapshot
screenshot "shots/read-main-empty-question-collapsed.png"
scroll down --until "id=agent-tool-toggle label=\"Inspect the synthetic offline title wrapping fixture across a narrow viewport and large system font while preserving the child session status and disclosure action · Idle · Expand tool call\""
is hidden "id=agent-tool-open-child"
is hidden "text=\"QA synthetic reader\""
snapshot
screenshot "shots/read-main-long-task-collapsed.png"
press "id=agent-tool-toggle label=\"Inspect the synthetic offline title wrapping fixture across a narrow viewport and large system font while preserving the child session status and disclosure action · Idle · Expand tool call\""
wait stable 600 10000
is visible "id=agent-tool-open-child"
is visible "text=\"QA synthetic reader\""
snapshot
screenshot "shots/read-main-long-task-expanded.png"
press "id=agent-tool-open-child"
wait "id=agent-subagent-detail-transcript" 10000
is visible "text=\"Native preview child\""
snapshot
screenshot "shots/read-main-long-task-child-entry.png"
back --system
wait "id=agent-tool-toggle label=\"Inspect the synthetic offline title wrapping fixture across a narrow viewport and large system font while preserving the child session status and disclosure action · Idle · Collapse tool call\"" 10000
press "id=agent-tool-toggle label=\"Inspect the synthetic offline title wrapping fixture across a narrow viewport and large system font while preserving the child session status and disclosure action · Idle · Collapse tool call\""
wait stable 600 10000

# section document
scroll up --until "id=agent-tool-toggle label=\"read · 71ms · Expand tool call\""
press "id=agent-tool-toggle label=\"read · 71ms · Expand tool call\"" --within-id "agent-tool-demo-preview-${HOST}-markdown-call"
wait "id=agent-read-document" 15000
snapshot
screenshot "shots/read-${HOST}-document-inline.png"
press "id=agent-read-preview"
wait "id=agent-read-full-document" 10000
is visible "text=QA_READ_DOCUMENT"
is visible "text=\"First sample item\""
is visible "text=\"Second sample item\""
snapshot
screenshot "shots/read-${HOST}-document-full-top.png"
scroll down --until "text=QA_TABLE_END"
is visible "text=QA_TABLE_END"
snapshot
screenshot "shots/read-${HOST}-document-full-table.png"
press "id=agent-read-close-preview"
wait absent "id=agent-read-close-preview" 10000
is visible "id=agent-tool-toggle label=\"read · 71ms · Collapse tool call\""
snapshot
screenshot "shots/read-${HOST}-document-close-return.png"
# section document-collapse
press "id=agent-tool-toggle label=\"read · 71ms · Collapse tool call\"" --within-id "agent-tool-demo-preview-${HOST}-markdown-call"
is visible "id=agent-tool-toggle label=\"read · 71ms · Expand tool call\""

# section code
scroll down --until "id=agent-tool-toggle label=\"read · 73ms · Expand tool call\""
press "id=agent-tool-toggle label=\"read · 73ms · Expand tool call\"" --within-id "agent-tool-demo-preview-${HOST}-code-call"
wait "id=agent-read-code" 15000
snapshot
screenshot "shots/read-${HOST}-code-inline.png"
press "id=agent-read-preview"
wait "id=agent-read-full-code" 10000
snapshot
screenshot "shots/read-${HOST}-code-full.png"
back --system
wait absent "id=agent-read-close-preview" 10000
is visible "id=agent-tool-toggle label=\"read · 73ms · Collapse tool call\""
snapshot
screenshot "shots/read-${HOST}-code-back-return.png"
# section code-collapse
press "id=agent-tool-toggle label=\"read · 73ms · Collapse tool call\"" --within-id "agent-tool-demo-preview-${HOST}-code-call"
is visible "id=agent-tool-toggle label=\"read · 73ms · Expand tool call\""

# section large
scroll down --until "id=agent-tool-toggle label=\"read · 79ms · Expand tool call\""
press "id=agent-tool-toggle label=\"read · 79ms · Expand tool call\"" --within-id "agent-tool-demo-preview-${HOST}-large-call"
wait "id=agent-read-lines" 15000
snapshot
screenshot "shots/read-${HOST}-large-inline.png"
press "id=agent-read-preview"
wait "id=agent-read-full-lines" 10000
is visible "text=Truncated"
scroll bottom
scroll down --until "text=QA_READ_LAST_AVAILABLE"
is visible "text=QA_READ_LAST_AVAILABLE"
is visible "text=Truncated"
snapshot
screenshot "shots/read-${HOST}-large-last-available.png"
press "id=agent-read-close-preview"
wait absent "id=agent-read-close-preview" 10000
is visible "id=agent-tool-toggle label=\"read · 79ms · Collapse tool call\""
snapshot
screenshot "shots/read-${HOST}-large-close-return.png"
# section large-collapse
press "id=agent-tool-toggle label=\"read · 79ms · Collapse tool call\"" --within-id "agent-tool-demo-preview-${HOST}-large-call"
is visible "id=agent-tool-toggle label=\"read · 79ms · Expand tool call\""

# section small
scroll down --until "id=agent-tool-toggle label=\"read · 83ms · Expand tool call\""
press "id=agent-tool-toggle label=\"read · 83ms · Expand tool call\"" --within-id "agent-tool-demo-preview-${HOST}-small-call"
wait "id=agent-read-code" 15000
is hidden "id=agent-read-preview"
is visible "text=\"const small = \\\"# QA_SMALL_CODE_END\\\";\""
snapshot
screenshot "shots/read-${HOST}-small-inline.png"
press "id=agent-tool-toggle label=\"read · 83ms · Collapse tool call\"" --within-id "agent-tool-demo-preview-${HOST}-small-call"

# section small-document
scroll down --until "id=agent-tool-toggle label=\"read · 89ms · Expand tool call\""
press "id=agent-tool-toggle label=\"read · 89ms · Expand tool call\"" --within-id "agent-tool-demo-preview-${HOST}-small-document-call"
wait "id=agent-read-document" 15000
is hidden "id=agent-read-preview"
scroll down --until "text=QA_SHORT_TABLE"
is visible "text=QA_SHORT_TABLE"
snapshot
screenshot "shots/read-${HOST}-small-document-inline.png"
press "id=agent-tool-toggle label=\"read · 89ms · Collapse tool call\"" --within-id "agent-tool-demo-preview-${HOST}-small-document-call"

# section reposition
scroll up 1

# section close
open "muqun:///"
wait stable 600 10000
