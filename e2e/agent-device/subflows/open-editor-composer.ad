# Editors expose a floating keyboard handle. Some layouts open the composer
# directly; others show a separate Write a line action first.
# section open
press "role=button label=\"Show the editor keyboard\""
wait stable 400 5000

# section write-line
wait "role=button label=\"Write a line\"" 10000
press "role=button label=\"Write a line\""

# section ready
wait "id=\"terminal-composer-input\"" 10000
