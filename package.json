{
  "name": "muqun",
  "version": "4.0.0",
  "private": true,
  "license": "Apache-2.0",
  "main": "index.ts",
  "scripts": {
    "icons:generate": "bun scripts/generate-icons.ts",
    "icons:check": "bun scripts/generate-icons.ts --check",
    "start": "expo start",
    "postinstall": "bun scripts/check-vendored-ratex.ts",
    "android": "expo run:android",
    "build:android:local": "bun scripts/store-release.ts build android",
    "release:android:local": "bun scripts/store-release.ts release android",
    "submit:android": "bun scripts/store-release.ts submit android",
    "build:ios:local": "bun scripts/store-release.ts build ios",
    "release:ios:local": "bun scripts/store-release.ts release ios",
    "submit:ios": "bun scripts/store-release.ts submit ios",
    "credentials:ios": "eas credentials --platform ios",
    "credentials:android": "eas credentials --platform android",
    "credentials:android:configure": "eas credentials:configure-build --platform android",
    "update:preview": "HOT_UPDATER_CHANNEL=preview EXPO_PUBLIC_HOT_UPDATER_ENABLED=1 bun scripts/deploy-hot-update.ts preview",
    "update:production": "HOT_UPDATER_CHANNEL=production EXPO_PUBLIC_HOT_UPDATER_ENABLED=1 bun scripts/deploy-hot-update.ts production",
    "update:prepare": "bun scripts/prepare-hot-updater-infra.ts",
    "update:doctor": "hot-updater doctor --json",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "mock:gateway": "bun scripts/mock-gateway.ts",
    "lint": "bun run icons:check && oxlint --deny-warnings",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "i18n:extract": "lingui extract --clean && bun scripts/normalize-translation-punctuation.ts",
    "i18n:compile": "lingui compile --typescript",
    "i18n": "bun run i18n:extract && bun run i18n:compile",
    "doctor": "npx react-doctor@latest",
    "i18n:check": "lingui check sync && lingui check missing --mode catalog"
  },
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@formatjs/intl-getcanonicallocales": "^3.3.0",
    "@formatjs/intl-locale": "^5.4.1",
    "@formatjs/intl-pluralrules": "^6.4.0",
    "@hot-updater/react-native": "1.1.5",
    "@legendapp/list": "^3.7.0",
    "@lingui/core": "^6.11.0",
    "@lingui/react": "^6.11.0",
    "@osuki-dev/react-native-splash": "0.4.0",
    "@osuki-dev/react-native-ssh": "0.3.1",
    "@osuki-dev/skia-diagrams": "0.2.0",
    "@osuki-dev/ui": "2.0.0",
    "@react-three/fiber": "9.8.2",
    "expo": "~58.0.21",
    "expo-alternate-app-icons": "^11.0.0",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-media-library": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-capture": "~58.0.6",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.25",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-android-widget": "^0.26.0",
    "react-native-better-pdf": "1.1.0",
    "react-native-enriched-markdown": "1.1.1",
    "react-native-gesture-handler": "~3.4.0",
    "react-native-keyboard-controller": "1.22.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nano-icons": "1.0.1",
    "react-native-nitro-fetch": "1.9.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-sound": "0.2.20",
    "react-native-nitro-text-decoder": "0.1.2",
    "react-native-nitro-websockets": "1.4.0",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.9",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.0",
    "react-native-screens": "4.30.1",
    "react-native-skia": "3.8.1",
    "react-native-video": "7.0.0-beta.12",
    "react-native-vision-camera": "^5.2.4",
    "react-native-vision-camera-barcode-scanner": "^5.2.4",
    "react-native-web": "~0.21.4",
    "react-native-webgpu": "0.19.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.1",
    "three": "0.187.0",
    "zod": "4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@expo/fingerprint": "0.21.7",
    "@hot-updater/cloudflare": "1.1.5",
    "@hot-updater/expo": "1.1.5",
    "@hot-updater/plugin-core": "1.1.5",
    "@hot-updater/server": "1.1.5",
    "@lingui/babel-plugin-lingui-macro": "^6.11.0",
    "@lingui/cli": "^6.11.0",
    "@lingui/format-po": "^6.11.0",
    "@oxlint/plugins": "^1.90.0",
    "@react-native-community/cli": "^20.2.0",
    "@types/react": "~19.3.0",
    "@types/three": "0.187.0",
    "eslint-plugin-lingui": "^0.16.0",
    "fonteditor-core": "2.6.3",
    "hot-updater": "1.1.5",
    "oxc-parser": "^0.156.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "hono": "4.13.14",
    "react-native-screens": "4.30.1"
  },
  "enriched-markdown": {
    "enableMath": true
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@osuki-dev/react-native-ssh",
          "react-native-nitro-fetch",
          "react-native-nitro-image"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-keyboard-controller",
        "typescript"
      ]
    }
  },
  "patchedDependencies": {
    "@legendapp/list@3.7.0": "patches/javascript/@legendapp%2Flist@3.7.0.patch",
    "react-native-enriched-markdown@1.1.1": "patches/react-native-enriched-markdown@1.1.1.patch",
    "react-native-nitro-sound@0.2.20": "patches/react-native-nitro-sound@0.2.20.patch",
    "expo-alternate-app-icons@11.0.0": "patches/expo-alternate-app-icons@11.0.0.patch"
  },
  "trustedDependencies": [
    "react-native-skia",
    "react-native-enriched-markdown"
  ]
}
