    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.6.0",
    "@lingui/cli": "^6.6.0",
    "@lingui/format-po": "^6.6.0",
    "@types/react": "~19.2.18",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "build:android": "eas build --platform android --profile preview",
    "build:android:local": "NODE_ENV=production _JAVA_OPTIONS='-Xmx4g -XX:MaxMetaspaceSize=2g' EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile preview --local",
    "build:android:production": "eas build --platform android --profile production",
    "build:android:production:local": "EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile production --local",
    "build:android:production-apk:local": "EAS_LOCAL_BUILD_WORKINGDIR=$(mktemp -d \"${TMPDIR:-/tmp}/muqun-eas-production.XXXXXX\") EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile production-apk --local",
    "submit:android": "npx eas-cli@latest build --platform android --profile production --auto-submit",
    "submit:android:latest": "npx eas-cli@latest submit --platform android --profile production --latest",
    "build:ios": "eas build --platform ios --profile testflight --auto-submit",
    "build:ios:production": "eas build --platform ios --profile production",
    "submit:ios": "eas build --platform ios --profile production --auto-submit",
    "credentials:ios": "eas credentials --platform ios",
    "credentials:android": "eas credentials --platform android",
    "credentials:android:configure": "eas credentials:configure-build --platform android",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "update:republish": "eas update:republish",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "mock:gateway": "bun scripts/mock-gateway.ts",
    "serve:apk": "bun scripts/serve-local-apk.ts",
    "test:notifications": "bun scripts/test-notification-route.ts",
    "test:pairing": "bun scripts/test-pairing.ts",
    "test:terminal": "bun scripts/test-terminal.ts",
    "lint": "expo lint --max-warnings 0",
    "i18n:extract": "lingui extract --clean",
    "i18n:compile": "lingui compile --typescript",
    "i18n": "bun run i18n:extract && bun run i18n:compile"
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@osuki-dev/react-native-ssh",
          "react-native-nitro-fetch",
          "react-native-nitro-image"
        ]
      }
    }
  },
  "private": true,
  "trustedDependencies": [
    "@shopify/react-native-skia"
  ],
  "overrides": {
    "react-native-screens": "4.26.2"
  },
  "patchedDependencies": {
    "@osuki-dev/ui@0.0.1": "patches/@osuki-dev%2Fui@0.0.1.patch"
  }
}
