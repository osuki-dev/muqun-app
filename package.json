{
  "name": "muqun",
  "version": "3.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "postinstall": "bun scripts/check-vendored-ratex.ts",
    "android": "expo run:android",
    "build:android": "eas build --platform android --profile preview",
    "build:android:local": "NODE_USE_ENV_PROXY=1 NODE_ENV=production _JAVA_OPTIONS='-Xmx4g -XX:MaxMetaspaceSize=2g' EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile preview --local",
    "build:android:production": "eas build --platform android --profile production",
    "build:android:production:local": "NODE_USE_ENV_PROXY=1 EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile production --local",
    "build:android:production-apk:local": "NODE_USE_ENV_PROXY=1 EAS_LOCAL_BUILD_WORKINGDIR=$(mktemp -d \"${TMPDIR:-/tmp}/muqun-eas-production.XXXXXX\") EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile production-apk --local",
    "release:android:local": "NODE_USE_ENV_PROXY=1 _JAVA_OPTIONS='-Xmx6g -XX:MaxMetaspaceSize=2g' EAS_LOCAL_BUILD_WORKINGDIR=$(mktemp -d \"${TMPDIR:-/tmp}/muqun-eas-android.XXXXXX\") EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform android --profile production --local && p=$(ls -t dist/eas-builds/*.aab | head -1) && echo \"Submitting $p\" && eas submit --platform android --profile production --path \"$p\"",
    "submit:android": "npx eas-cli@latest build --platform android --profile production --auto-submit",
    "submit:android:latest": "npx eas-cli@latest submit --platform android --profile production --latest",
    "build:ios": "eas build --platform ios --profile testflight --auto-submit",
    "build:ios:production": "eas build --platform ios --profile production",
    "release:ios:local": "NODE_USE_ENV_PROXY=1 EAS_LOCAL_BUILD_WORKINGDIR=$(mktemp -d \"${TMPDIR:-/tmp}/muqun-eas-ios.XXXXXX\") EAS_LOCAL_BUILD_ARTIFACTS_DIR=\"$PWD/dist/eas-builds\" eas build --platform ios --profile production --local && p=$(ls -t dist/eas-builds/*.ipa | head -1) && echo \"Submitting $p\" && eas submit --platform ios --profile production --path \"$p\"",
    "submit:ios": "eas build --platform ios --profile production --auto-submit",
    "credentials:ios": "eas credentials --platform ios",
    "credentials:android": "eas credentials --platform android",
    "credentials:android:configure": "eas credentials:configure-build --platform android",
    "update:preview": "eas update --channel preview --environment preview",
    "update:production": "eas update --channel production --environment production",
    "update:republish": "eas update:republish",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "mock:gateway": "bun scripts/mock-gateway.ts",
    "serve:apk": "bun scripts/serve-local-apk.ts",
    "test:notifications": "bun scripts/test-notification-route.ts",
    "test:pairing": "bun scripts/test-pairing.ts",
    "test:terminal": "bun scripts/test-terminal.ts",
    "lint": "oxlint --deny-warnings",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "i18n:extract": "lingui extract --clean && bun scripts/normalize-translation-punctuation.ts",
    "i18n:compile": "lingui compile --typescript",
    "i18n": "bun run i18n:extract && bun run i18n:compile",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@expo/ui": "~57.0.19",
    "@formatjs/intl-getcanonicallocales": "^3.2.12",
    "@formatjs/intl-locale": "^5.3.11",
    "@formatjs/intl-pluralrules": "^6.3.15",
    "@legendapp/list": "^3.3.11",
    "@lingui/core": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@osuki-dev/react-native-splash": "0.4.0",
    "@osuki-dev/react-native-ssh": "0.3.0",
    "@osuki-dev/ui": "^1.1.0",
    "@shopify/react-native-skia": "2.12.0",
    "expo": "~57.0.24",
    "expo-alternate-app-icons": "^8.0.0",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.18",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.19",
    "expo-image-picker": "~57.0.19",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "^57.0.2",
    "expo-navigation-bar": "~57.0.2",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-screen-capture": "~57.0.3",
    "expo-screen-orientation": "~57.0.2",
    "expo-secure-store": "^57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "expo-widgets": "~57.0.20",
    "fflate": "0.8.3",
    "lucide-react-native": "1.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-enriched-markdown": "^1.0.2",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-fetch": "1.7.0",
    "react-native-nitro-image": "^0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-nitro-text-decoder": "0.2.0",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.7",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-vision-camera": "^5.2.3",
    "react-native-vision-camera-barcode-scanner": "^5.2.3",
    "react-native-web": "~0.21.2",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.12.2",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@lingui/babel-plugin-lingui-macro": "^6.7.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/format-po": "^6.7.0",
    "@types/react": "~19.2.18",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "7.0.2",
    "typescript-compiler-api": "npm:typescript@6.0.3"
  },
  "overrides": {
    "react-native-screens": "4.28.0"
  },
  "enriched-markdown": {
    "enableMath": true
  },
  "expo": {
    "autolinking": {
      "ios": {
        "exclude": [
          "react-native-vision-camera-barcode-scanner"
        ]
      }
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@osuki-dev/react-native-ssh",
          "react-native-nitro-fetch",
          "react-native-nitro-image"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-gesture-handler",
        "react-native-keyboard-controller",
        "react-native-reanimated",
        "react-native-safe-area-context",
        "react-native-svg",
        "react-native-webview",
        "react-native-worklets",
        "@shopify/react-native-skia",
        "react-native-screens",
        "typescript"
      ]
    }
  },
  "patchedDependencies": {
    "@shopify/react-native-skia@2.12.0": "patches/@shopify%2Freact-native-skia@2.12.0.patch"
  },
  "trustedDependencies": [
    "@shopify/react-native-skia",
    "react-native-enriched-markdown"
  ]
}
